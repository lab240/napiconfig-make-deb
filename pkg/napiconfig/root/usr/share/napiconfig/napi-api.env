# NaPi API configuration (Armbian package).
# The file is created on first install and is not replaced on upgrade.
# The full list of options: /opt/napiconfig/app/.env.example

# Literal["development", "production"]
ENVIRONMENT='production'

# Secret for API key generation (not JWT).
# napi-api.service generates it on first start (app.prestart).
KEY_API_SECRET=

# Runtime data lives outside the code directory.
# db/ is root-only; sensor_configs/ must stay readable for telegraf.
DATABASE_URI='sqlite:////var/lib/napi-api/db/database.db'
SENSOR_CONFIGS_STORAGE_PATH='/var/lib/napi-api/sensor_configs/'

# LOG_LEVEL=INFO
# LOG_FILE_PATH=

# InfluxDBv2 configuration
INFLUXDB_URL='http://localhost:8086'
INFLUXDB_TOKEN=''
INFLUXDB_ORG=''
INFLUXDB_BUCKET=''

# Initial admin user, created when the database is empty.
# ADMIN_INIT_USERNAME='admin'
# ADMIN_INIT_PASSWORD='admin'
# ADMIN_INIT_EMAIL='admin@example.com'

# Network: the netplan file that the web UI owns.
# NETPLAN_CONFIG_PATH='/etc/netplan/01-network.yaml'
# NETWORK_RENDERER='NetworkManager'
